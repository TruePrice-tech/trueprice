{
  "crons": [
    {
      "path": "/api/daily-counter-tick",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/pricing-event-scan",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/vertical-health",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/pricing-drift-check",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/cron-heartbeat",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/flywheel-integrity",
      "schedule": "0 16 1 * *"
    },
    {
      "path": "/api/email-digest-cron",
      "schedule": "0 14 1 * *"
    },
    {
      "path": "/api/discovery-scan",
      "schedule": "0 14 * * 0"
    }
  ],
