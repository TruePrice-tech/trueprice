    },
    "api/calibration.js": {
      "maxDuration": 10
    },
    "api/share-estimate.js": {
      "maxDuration": 10
    },
    "api/contractor-score.js": {
      "maxDuration": 10
    },
    "api/recommendations.js": {
      "maxDuration": 10
    },
    "api/beta-auth-request.js": {
      "maxDuration": 10
    },
    "api/beta-auth-verify.js": {
      "maxDuration": 10
    },
    "api/beta-burrow.js": {
      "maxDuration": 10
    },
    "api/beta-admin.js": {
      "maxDuration": 10
    },
    "api/beta-logout.js": {
      "maxDuration": 5
    },
    "api/beta-quote-submit.js": {
      "maxDuration": 15
    },
    "api/beta-receipt-submit.js": {
      "maxDuration": 30
    },
    "api/beta-redeem.js": {
      "maxDuration": 10
    },
    "api/beta-interest.js": {
      "maxDuration": 5
    },
    "api/pricing-drift-check.js": {
      "maxDuration": 60
    },
    "api/email-digest-cron.js": {
      "maxDuration": 60
    },
    "api/cron-heartbeat.js": {
      "maxDuration": 30
    },
    "api/vertical-health.js": {
      "maxDuration": 60
    },
    "api/flywheel-integrity.js": {
      "maxDuration": 60
    },
    "api/pricing-event-scan.js": {
      "maxDuration": 60
    },
    "api/pricing-events-active.js": {
      "maxDuration": 5
    },
    "api/usage-status.js": {
      "maxDuration": 5
    },
    "api/discovery-scan.js": {
      "maxDuration": 60
    },
    "api/beta-watch-list.js": {
      "maxDuration": 5
    },
    "api/beta-watch-add.js": {
      "maxDuration": 5
    },
    "api/beta-watch-remove.js": {
      "maxDuration": 5
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/widget/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/experiments/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/beta/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/api/beta-(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/api/widget-data",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "trailingSlash": false,
  "cleanUrls": false,
  "routes": [
